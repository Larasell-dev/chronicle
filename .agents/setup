#!/usr/bin/env bash
# Prepares a fresh Amp orb (Debian 12) to test and format this package.
# Must stay non-interactive and idempotent: stale snapshots rerun it.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local label="$1"
  shift
  local start=$SECONDS
  echo "==> $label"
  "$@"
  echo "<== $label ($((SECONDS - start))s)"
}

php_version=8.4
php_packages=(
  "php$php_version-cli"
  "php$php_version-curl"
  "php$php_version-mbstring"
  "php$php_version-xml"
  "php$php_version-zip"
)

install_php() {
  local missing=()
  for package in "${php_packages[@]}"; do
    dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q "install ok installed" || missing+=("$package")
  done
  if [ ${#missing[@]} -eq 0 ]; then
    echo "PHP $php_version packages already installed"
    return
  fi

  # Debian 12 only ships PHP 8.2; composer.json requires ^8.4.
  if [ ! -f /etc/apt/sources.list.d/php.list ]; then
    sudo apt-get update -qq
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ca-certificates curl lsb-release
    sudo curl -fsSLo /usr/share/keyrings/deb.sury.org-php.gpg https://packages.sury.org/php/apt.gpg
    echo "deb [signed-by=/usr/share/keyrings/deb.sury.org-php.gpg] https://packages.sury.org/php/ $(lsb_release -sc) main" |
      sudo tee /etc/apt/sources.list.d/php.list >/dev/null
  fi
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends unzip "${missing[@]}"
}

install_composer() {
  if command -v composer >/dev/null; then
    echo "Composer already installed: $(composer --version 2>/dev/null)"
    return
  fi
  local installer_directory
  installer_directory="$(mktemp -d)"
  curl -fsSL https://getcomposer.org/installer -o "$installer_directory/composer-setup.php"
  php "$installer_directory/composer-setup.php" --quiet --install-dir="$installer_directory" --filename=composer
  sudo install -m 0755 "$installer_directory/composer" /usr/local/bin/composer
  rm -rf "$installer_directory"
}

install_dependencies() {
  composer install --prefer-dist --no-interaction --no-progress
}

step "Install PHP $php_version" install_php
step "Install Composer" install_composer
step "Install Composer dependencies" install_dependencies
