{
    "name": "larasell-dev/chronicle",
    "description": "Simple structured request logging for Laravel.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Larasell\\Chronicle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Larasell\\Chronicle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "format": "pint",
        "format:check": "pint --test"
    },
    "scripts-descriptions": {
        "test": "Run the test suite",
        "analyse": "Run PHPStan at its strictest level",
        "format": "Fix code style with Pint",
        "format:check": "Check code style with Pint without fixing"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Larasell\\Chronicle\\ChronicleServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
