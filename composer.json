{
    "name": "larasell-dev/chronicle",
    "description": "Simple structured request logging for Laravel.",
    "license": "MIT",
    "type": "library",
    "version": "0.1.0",
    "require": {
        "php": "^8.3",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.22",
        "open-telemetry/api": "^1.10",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/sdk": "^1.15",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "suggest": {
        "open-telemetry/sdk": "Required to use the posthog log driver (^1.15)",
        "open-telemetry/exporter-otlp": "Required to use the posthog log driver (^1.4)",
        "open-telemetry/api": "Required to use the posthog log driver (^1.10)"
    },
    "autoload": {
        "psr-4": {
            "Larasell\\Chronicle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Larasell\\Chronicle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Larasell\\Chronicle\\ChronicleServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}