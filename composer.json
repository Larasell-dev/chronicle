{
    "name": "larasell-dev/chronicle",
    "description": "Simple structured request logging for Laravel.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.22",
        "open-telemetry/api": "^1.10",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/sdk": "^1.15",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^5.0"
    },
    "suggest": {
        "open-telemetry/sdk": "Required to use the posthog log driver (^1.15)",
        "open-telemetry/exporter-otlp": "Required to use the posthog log driver (^1.4)",
        "open-telemetry/api": "Required to use the posthog log driver (^1.10)"
    },
    "autoload": {
        "psr-4": {
            "Larasell\\Chronicle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Larasell\\Chronicle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "format:check": "pint --test"
    },
    "scripts-descriptions": {
        "test": "Run the test suite",
        "format": "Fix code style with Pint",
        "format:check": "Check code style with Pint without fixing"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Larasell\\Chronicle\\ChronicleServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
